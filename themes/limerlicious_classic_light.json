	"tokenColors": [
		{
			"scope": [
				"meta",
				"meta.embedded",
				"source.groovy.embedded",
				"string meta.image.inline.markdown",
				"variable.legacy.builtin.python"
			],
			"settings": {
				"foreground": "#333333"
			}
		},
		{
			"scope": "emphasis",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "strong",
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": "header",
			"settings": {
				"foreground": "#2a7aa0"
			}
		},
		{
			"scope": [
				"comment"
			],
			"settings": {
				"foreground": "#5d8a62"
			}
		},
		{
			"scope": "constant.language",
			"settings": {
				"foreground": "#2a7aa0"
			}
		},
		{
			"scope": [
				"constant.numeric",
				// "variable.other.enummember",
				"keyword.operator.plus.exponent",
				"keyword.operator.minus.exponent"
			],
			"settings": {
				"foreground": "#4f7f3f"
			}
		},
		{
			"scope": "constant.regexp",
			"settings": {
				"foreground": "#555890"
			}
		},
		{
			"scope": "entity.name.tag",
			"settings": {
				"foreground": "#2a7aa0"
			}
		},
		{
			"scope": [
				"entity.name.tag.css",
				"entity.name.tag.less"
			],
			"settings": {
				"foreground": "#9a6f12"
			}
		},
		{
			"scope": "entity.other.attribute-name",
			"settings": {
				"foreground": "#2c7fbf"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name.class.css",
				"source.css entity.other.attribute-name.class",
				"entity.other.attribute-name.id.css",
				"entity.other.attribute-name.parent-selector.css",
				"entity.other.attribute-name.parent.less",
				"source.css entity.other.attribute-name.pseudo-class",
				"entity.other.attribute-name.pseudo-element.css",
				"source.css.less entity.other.attribute-name.id",
				"entity.other.attribute-name.scss"
			],
			"settings": {
				"foreground": "#9a6f12"
			}
		},
		{
			"scope": "invalid",
			"settings": {
				"foreground": "#c62f2f"
			}
		},
		{
			"scope": "markup.underline",
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"scope": "markup.bold",
			"settings": {
				"fontStyle": "bold",
				"foreground": "#2a7aa0"
			}
		},
		{
			"scope": "markup.heading",
			"settings": {
				"fontStyle": "bold",
				"foreground": "#2a7aa0"
			}
		},
		{
			"scope": "markup.italic",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "markup.strikethrough",
			"settings": {
				"fontStyle": "strikethrough"
			}
		},
		{
			"scope": "markup.inserted",
			"settings": {
				"foreground": "#4f7f3f"
			}
		},
		{
			"scope": "markup.deleted",
			"settings": {
				"foreground": "#a14f2c"
			}
		},
		{
			"scope": "markup.changed",
			"settings": {
				"foreground": "#2a7aa0"
			}
		},
		{
			"scope": "punctuation.definition.quote.begin.markdown",
			"settings": {
				"foreground": "#4f7a3e"
			}
		},
		{
			"scope": "punctuation.definition.list.begin.markdown",
			"settings": {
				"foreground": "#3a6fc4"
			}
		},
		{
			"scope": "markup.inline.raw",
			"settings": {
				"foreground": "#a14f2c"
			}
		},
		{
			"name": "brackets of XML/HTML tags",
			"scope": "punctuation.definition.tag",
			"settings": {
				"foreground": "#6a6a6a"
			}
		},
		{
			"scope": [
				"meta.preprocessor",
				"entity.name.function.preprocessor"
			],
			"settings": {
				"foreground": "#2a7aa0"
			}
		},
		{
			"scope": "meta.preprocessor.string",
			"settings": {
				"foreground": "#a14f2c"
			}
		},
		{
			"scope": "meta.preprocessor.numeric",
			"settings": {
				"foreground": "#4f7f3f"
			}
		},
		{
			"scope": "meta.structure.dictionary.key.python",
			"settings": {
				"foreground": "#2c7fbf"
			}
		},
		{
			"scope": "meta.diff.header",
			"settings": {
				"foreground": "#2a7aa0"
			}
		},
		{
			"scope": "storage",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#2a7aa0"
			}
		},
		{
			"scope": "storage.type",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#2a7aa0"
			}
		},
		{
			"scope": [
				"storage.modifier",
				"keyword.operator.noexcept"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#2a7aa0"
			}
		},
		{
			"scope": [
				"string",
				"meta.embedded.assembly"
			],
			"settings": {
				"foreground": "#a14f2c"
			}
		},
		{
			"scope": "string.tag",
			"settings": {
				"foreground": "#a14f2c"
			}
		},
		{
			"scope": "string.value",
			"settings": {
				"foreground": "#a14f2c"
			}
		},
		{
			"scope": "string.regexp",
			"settings": {
				"foreground": "#b23a3a"
			}
		},
		{
			"name": "String interpolation",
			"scope": [
				"punctuation.definition.template-expression.begin",
				"punctuation.definition.template-expression.end",
				"punctuation.section.embedded"
			],
			"settings": {
				"foreground": "#2a7aa0"
			}
		},
		{
			"name": "Reset JavaScript string interpolation expression",
			"scope": [
				"meta.template.expression"
			],
			"settings": {
				"foreground": "#333333"
			}
		},
		{
			"scope": [
				"support.type.vendored.property-name",
				"support.type.property-name",
				"source.css variable",
				"source.coffee.embedded"
			],
			"settings": {
				"foreground": "#2c7fbf"
			}
		},
		{
			"scope": "keyword",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#1f6e96"
			}
		},
		{
			"scope": "keyword.operator",
			"settings": {
				"fontStyle": "",
				"foreground": "#333333"
			}
		},
		{
			"scope": [
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.cast",
				"keyword.operator.sizeof",
				"keyword.operator.alignof",
				"keyword.operator.typeid",
				"keyword.operator.alignas",
				"keyword.operator.instanceof",
				"keyword.operator.logical.python",
				"keyword.operator.wordlike"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#2a7aa0"
			}
		},
		{
			"scope": "keyword.other.unit",
			"settings": {
				"foreground": "#4f7f3f"
			}
		},
		{
			"scope": [
				"punctuation.section.embedded.begin.php",
				"punctuation.section.embedded.end.php"
			],
			"settings": {
				"foreground": "#2a7aa0"
			}
		},
		{
			"scope": "support.function.git-rebase",
			"settings": {
				"foreground": "#2c7fbf"
			}
		},
		{
			"scope": "constant.sha.git-rebase",
			"settings": {
				"foreground": "#4f7f3f"
			}
		},
		{
			"name": "coloring of the Java import and package identifiers",
			"scope": [
				"storage.modifier.import.java",
				"variable.language.wildcard.java",
				"storage.modifier.package.java"
			],
			"settings": {
				"foreground": "#333333"
			}
		},
		{
			"name": "this.self",
			"scope": "variable.language",
			"settings": {
				"foreground": "#2a7aa0"
			}
		},
		{
			"name": "Go — functions (declarations, calls, built-ins)",
			"scope": [
				"entity.name.function.go",
				"support.function.go",
				"support.function.builtin.go"
			],
			"settings": {
				"foreground": "#777b1a"
			}
		},
		{
			"name": "Go — user-defined type names",
			"scope": [
				"entity.name.type.go",
				"source.go storage.type"
			],
			"settings": {
				"foreground": "#128067"
			}
		},
		{
			"name": "Go — built-in primitive types (int, string, bool, byte, rune, error…)",
			"scope": "support.type.builtin.go",
			"settings": {
				"foreground": "#2a7aa0"
			}
		},
		{
			"name": "Go — package name",
			"scope": "entity.name.package.go",
			"settings": {
				"foreground": "#3b7ea3"
			}
		},
		{
			"name": "Go — import paths",
			"scope": "entity.name.import.go",
			"settings": {
				"foreground": "#8a8a8a"
			}
		},
		{
			"name": "Go — variable references",
			"scope": "variable.other.go",
			"settings": {
				"foreground": "#2f6f8f"
			}
		},
		{
			"name": "Go — struct field access",
			"scope": "variable.other.property.go",
			"settings": {
				"foreground": "#2c7fbf"
			}
		},
		{
			"name": "Go — assignment targets",
			"scope": "variable.other.assignment.go",
			"settings": {
				"foreground": "#333333"
			}
		},
		{
			"name": "other",
			"scope": [
				"entity",
				"variable"
			],
			"settings": {
				"foreground": "#333333"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"class": "#128067",
		"constant": "#333333",
		"controlKeyword": {
			"foreground": "#8e4a92",
			"fontStyle": "italic"
		},
		"enum": "#6b7a37",
		"enumMember": "#6b7a37",
		"function": "#777b1a",
		"interface": "#6b7a37",
		"jsonPropertyName": "#3b7ea3",
		"label": "#9a6f12",
		"method": "#777b1a",
		"namespace": "#3b7ea3",
		"number": "#4f7f3f",
		"parameter": "#2c7fbf",
		"property": "#333333",
		"property:go": "#333333",
		"struct": "#2e7a50",
		"type": "#128067",
		"typeParameter": "#6b7a37",
		"variable": "#333333",
	}
}
