	"tokenColors": [
		{
			"scope": [
				"meta.embedded",
				"source.groovy.embedded",
				"meta.template.expression"
			],
			"settings": {
				"foreground": "#d4be98"
			}
		},
		{
			"name": "Variables / default",
			"scope": [
				"entity",
				"variable",
				"variable.other",
				"variable.parameter"
			],
			"settings": {
				"foreground": "#d4be98"
			}
		},
		{
			"scope": "emphasis",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "strong",
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": "comment",
			"settings": {
				"foreground": "#7c6f64",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"comment.block.documentation",
				"comment.line.documentation",
				"comment.block.javadoc"
			],
			"settings": {
				"foreground": "#928374",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.cast",
				"keyword.operator.sizeof",
				"keyword.operator.instanceof",
				"keyword.operator.logical.python",
				"keyword.operator.wordlike",
				"keyword.operator.noexcept"
			],
			"settings": {
				"foreground": "#78b3a6",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Operators",
			"scope": [
				"keyword.operator",
				"punctuation.accessor",
				"punctuation.separator.key-value"
			],
			"settings": {
				"foreground": "#85b97d",
				"fontStyle": ""
			}
		},
		{
			"name": "Punctuation",
			"scope": [
				"punctuation",
				"meta.brace",
				"punctuation.definition.tag"
			],
			"settings": {
				"foreground": "#c5b18d"
			}
		},
		{
			"name": "String interpolation",
			"scope": [
				"punctuation.definition.template-expression",
				"punctuation.section.embedded"
			],
			"settings": {
				"foreground": "#b1667a"
			}
		},
		{
			"name": "Strings",
			"scope": [
				"string",
				"meta.embedded.assembly",
				"string.tag",
				"string.value",
				"markup.inline.raw"
			],
			"settings": {
				"foreground": "#aebe5d"
			}
		},
		{
			"name": "Escapes",
			"scope": [
				"constant.character.escape",
				"constant.character.format"
			],
			"settings": {
				"foreground": "#928374"
			}
		},
		{
			"name": "Regex / symbols",
			"scope": [
				"string.regexp",
				"constant.regexp",
				"constant.other.symbol"
			],
			"settings": {
				"foreground": "#b1667a"
			}
		},
		{
			"name": "Numbers",
			"scope": [
				"constant.numeric",
				"keyword.other.unit",
				"keyword.operator.plus.exponent",
				"keyword.operator.minus.exponent",
				"constant.sha.git-rebase"
			],
			"settings": {
				"foreground": "#b1667a"
			}
		},
		{
			"name": "Builtin constants / self",
			"scope": [
				"constant.language",
				"variable.language",
				"support.variable.self"
			],
			"settings": {
				"foreground": "#b1667a"
			}
		},
		{
			"name": "Constants",
			"scope": [
				"constant",
				"variable.other.constant",
				"support.constant"
			],
			"settings": {
				"foreground": "#db7e97"
			}
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call.generic",
				"entity.name.function.member",
				"support.function.git-rebase"
			],
			"settings": {
				"foreground": "#85b97d"
			}
		},
		{
			"name": "Types",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.struct",
				"entity.name.interface",
				"entity.other.inherited-class",
				"support.type",
				"support.class",
				"storage.type.primitive",
				"support.type.builtin.go",
				"source.go storage.type"
			],
			"settings": {
				"foreground": "#85b97d"
			}
		},
		{
			"name": "Interfaces",
			"scope": [
				"entity.name.type.interface",
				"entity.name.interface"
			],
			"settings": {
				"foreground": "#d0c47c"
			}
		},
		{
			"name": "Enums",
			"scope": [
				"entity.name.type.enum"
			],
			"settings": {
				"foreground": "#db7e97"
			}
		},
		{
			"name": "Enum members",
			"scope": [
				"variable.other.enummember",
				"constant.other.enum"
			],
			"settings": {
				"foreground": "#85b97d"
			}
		},
		{
			"name": "Namespaces",
			"scope": [
				"entity.name.namespace",
				"entity.name.package",
				"entity.name.module",
				"entity.name.scope-resolution",
				"storage.modifier.import.java",
				"storage.modifier.package.java"
			],
			"settings": {
				"foreground": "#a89984"
			}
		},
		{
			"name": "Properties",
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"support.type.property-name",
				"support.type.vendored.property-name",
				"meta.object-literal.key",
				"meta.structure.dictionary.key.python",
				"entity.name.tag.yaml",
				"support.type.property-name.json"
			],
			"settings": {
				"foreground": "#d4be98"
			}
		},
		{
			"name": "Tags",
			"scope": [
				"entity.name.tag"
			],
			"settings": {
				"foreground": "#78b3a6"
			}
		},
		{
			"name": "Attributes / decorators / labels",
			"scope": [
				"entity.other.attribute-name",
				"meta.decorator",
				"entity.name.function.decorator",
				"punctuation.decorator",
				"storage.type.annotation",
				"entity.name.label"
			],
			"settings": {
				"foreground": "#78b3a6"
			}
		},
		{
			"name": "CSS selectors",
			"scope": [
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.id.css",
				"source.css entity.other.attribute-name.pseudo-class",
				"entity.other.attribute-name.pseudo-element.css",
				"entity.name.tag.css",
				"entity.other.attribute-name.scss"
			],
			"settings": {
				"foreground": "#f6873f"
			}
		},
		{
			"scope": [
				"source.css variable",
				"variable.css",
				"variable.scss"
			],
			"settings": {
				"foreground": "#d4be98"
			}
		},
		{
			"name": "Preprocessor",
			"scope": [
				"meta.preprocessor",
				"entity.name.function.preprocessor",
				"keyword.control.directive"
			],
			"settings": {
				"foreground": "#db7e97"
			}
		},
		{
			"scope": "invalid",
			"settings": {
				"foreground": "#f85d54"
			}
		},
		{
			"name": "Markdown",
			"scope": [
				"markup.heading",
				"entity.name.section.markdown",
				"header"
			],
			"settings": {
				"foreground": "#f85d54",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "markup.bold",
			"settings": {
				"foreground": "#b1667a",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "markup.italic",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "markup.underline",
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"scope": "markup.strikethrough",
			"settings": {
				"fontStyle": "strikethrough"
			}
		},
		{
			"scope": [
				"markup.underline.link",
				"string.other.link"
			],
			"settings": {
				"foreground": "#85b97d"
			}
		},
		{
			"scope": "punctuation.definition.list.begin.markdown",
			"settings": {
				"foreground": "#f85d54"
			}
		},
		{
			"scope": [
				"markup.quote",
				"punctuation.definition.quote.begin.markdown"
			],
			"settings": {
				"foreground": "#928374",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "markup.inserted",
			"settings": {
				"foreground": "#aebe5d"
			}
		},
		{
			"scope": "markup.deleted",
			"settings": {
				"foreground": "#f85d54"
			}
		},
		{
			"scope": [
				"markup.changed",
				"meta.diff.header"
			],
			"settings": {
				"foreground": "#e5a94a"
			}
		},
		{
			"name": "Go — import paths",
			"scope": "entity.name.import.go",
			"settings": {
				"foreground": "#707070"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"class": "#85b97d",
		"struct": "#85b97d",
		"type": "#85b97d",
		"interface": "#d0c47c",
		"typeParameter": "#85b97d",
		"enum": "#db7e97",
		"enumMember": "#85b97d",
		"function": "#85b97d",
		"method": "#85b97d",
		"macro": "#78b3a6",
		"namespace": "#a89984",
		"parameter": "#d4be98",
		"variable": "#d4be98",
		"property": "#d4be98",
		"jsonPropertyName": "#d4be98",
		"variable.readonly": "#db7e97",
		"constant": "#db7e97",
		"number": "#b1667a",
		"selfKeyword": "#b1667a",
		"decorator": "#78b3a6",
		"label": "#78b3a6",
		"controlKeyword": {
			"foreground": "#78b3a6",
			"fontStyle": "italic"
		}
	}
}
