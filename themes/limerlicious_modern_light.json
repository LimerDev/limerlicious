	"tokenColors": [
		{
			"scope": [
				"meta.embedded",
				"source.groovy.embedded",
				"meta.template.expression"
			],
			"settings": {
				"foreground": "#654735"
			}
		},
		{
			"name": "Variables / default",
			"scope": [
				"entity",
				"variable",
				"variable.other",
				"variable.parameter"
			],
			"settings": {
				"foreground": "#654735"
			}
		},
		{
			"scope": "emphasis",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "strong",
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": "comment",
			"settings": {
				"foreground": "#928374",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"comment.block.documentation",
				"comment.line.documentation",
				"comment.block.javadoc"
			],
			"settings": {
				"foreground": "#7c6f64",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.cast",
				"keyword.operator.sizeof",
				"keyword.operator.instanceof",
				"keyword.operator.logical.python",
				"keyword.operator.wordlike",
				"keyword.operator.noexcept"
			],
			"settings": {
				"foreground": "#217484",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Operators",
			"scope": [
				"keyword.operator",
				"punctuation.accessor",
				"punctuation.separator.key-value"
			],
			"settings": {
				"foreground": "#2c8052",
				"fontStyle": ""
			}
		},
		{
			"name": "Punctuation",
			"scope": [
				"punctuation",
				"meta.brace",
				"punctuation.definition.tag"
			],
			"settings": {
				"foreground": "#7c6150"
			}
		},
		{
			"name": "String interpolation",
			"scope": [
				"punctuation.definition.template-expression",
				"punctuation.section.embedded"
			],
			"settings": {
				"foreground": "#a54e88"
			}
		},
		{
			"name": "Strings",
			"scope": [
				"string",
				"meta.embedded.assembly",
				"string.tag",
				"string.value",
				"markup.inline.raw"
			],
			"settings": {
				"foreground": "#6b7901"
			}
		},
		{
			"name": "Escapes",
			"scope": [
				"constant.character.escape",
				"constant.character.format"
			],
			"settings": {
				"foreground": "#7c6f64"
			}
		},
		{
			"name": "Regex / symbols",
			"scope": [
				"string.regexp",
				"constant.regexp",
				"constant.other.symbol"
			],
			"settings": {
				"foreground": "#a54e88"
			}
		},
		{
			"name": "Numbers",
			"scope": [
				"constant.numeric",
				"keyword.other.unit",
				"keyword.operator.plus.exponent",
				"keyword.operator.minus.exponent",
				"constant.sha.git-rebase"
			],
			"settings": {
				"foreground": "#a54e88"
			}
		},
		{
			"name": "Builtin constants / self",
			"scope": [
				"constant.language",
				"variable.language",
				"support.variable.self"
			],
			"settings": {
				"foreground": "#a54e88"
			}
		},
		{
			"name": "Constants",
			"scope": [
				"constant",
				"variable.other.constant",
				"support.constant"
			],
			"settings": {
				"foreground": "#cc2484"
			}
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call.generic",
				"entity.name.function.member",
				"support.function.git-rebase"
			],
			"settings": {
				"foreground": "#2c8052"
			}
		},
		{
			"name": "Types",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.struct",
				"entity.name.interface",
				"entity.other.inherited-class",
				"support.type",
				"support.class",
				"storage.type.primitive",
				"support.type.builtin.go",
				"source.go storage.type"
			],
			"settings": {
				"foreground": "#2c8052"
			}
		},
		{
			"name": "Interfaces",
			"scope": [
				"entity.name.type.interface",
				"entity.name.interface"
			],
			"settings": {
				"foreground": "#807503"
			}
		},
		{
			"name": "Enums",
			"scope": [
				"entity.name.type.enum"
			],
			"settings": {
				"foreground": "#cc2484"
			}
		},
		{
			"name": "Enum members",
			"scope": [
				"variable.other.enummember",
				"constant.other.enum"
			],
			"settings": {
				"foreground": "#2c8052"
			}
		},
		{
			"name": "Namespaces",
			"scope": [
				"entity.name.namespace",
				"entity.name.package",
				"entity.name.module",
				"entity.name.scope-resolution",
				"storage.modifier.import.java",
				"storage.modifier.package.java"
			],
			"settings": {
				"foreground": "#7c6f64"
			}
		},
		{
			"name": "Properties",
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"support.type.property-name",
				"support.type.vendored.property-name",
				"meta.object-literal.key",
				"meta.structure.dictionary.key.python",
				"entity.name.tag.yaml",
				"support.type.property-name.json"
			],
			"settings": {
				"foreground": "#654735"
			}
		},
		{
			"name": "Tags",
			"scope": [
				"entity.name.tag"
			],
			"settings": {
				"foreground": "#217484"
			}
		},
		{
			"name": "Attributes / decorators / labels",
			"scope": [
				"entity.other.attribute-name",
				"meta.decorator",
				"entity.name.function.decorator",
				"punctuation.decorator",
				"storage.type.annotation",
				"entity.name.label"
			],
			"settings": {
				"foreground": "#217484"
			}
		},
		{
			"name": "CSS selectors",
			"scope": [
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.id.css",
				"source.css entity.other.attribute-name.pseudo-class",
				"entity.other.attribute-name.pseudo-element.css",
				"entity.name.tag.css",
				"entity.other.attribute-name.scss"
			],
			"settings": {
				"foreground": "#c45d01"
			}
		},
		{
			"scope": [
				"source.css variable",
				"variable.css",
				"variable.scss"
			],
			"settings": {
				"foreground": "#654735"
			}
		},
		{
			"name": "Preprocessor",
			"scope": [
				"meta.preprocessor",
				"entity.name.function.preprocessor",
				"keyword.control.directive"
			],
			"settings": {
				"foreground": "#cc2484"
			}
		},
		{
			"scope": "invalid",
			"settings": {
				"foreground": "#de042d"
			}
		},
		{
			"name": "Markdown",
			"scope": [
				"markup.heading",
				"entity.name.section.markdown",
				"header"
			],
			"settings": {
				"foreground": "#de042d",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "markup.bold",
			"settings": {
				"foreground": "#a54e88",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "markup.italic",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "markup.underline",
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"scope": "markup.strikethrough",
			"settings": {
				"fontStyle": "strikethrough"
			}
		},
		{
			"scope": [
				"markup.underline.link",
				"string.other.link"
			],
			"settings": {
				"foreground": "#2c8052"
			}
		},
		{
			"scope": "punctuation.definition.list.begin.markdown",
			"settings": {
				"foreground": "#de042d"
			}
		},
		{
			"scope": [
				"markup.quote",
				"punctuation.definition.quote.begin.markdown"
			],
			"settings": {
				"foreground": "#7c6f64",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "markup.inserted",
			"settings": {
				"foreground": "#6b7901"
			}
		},
		{
			"scope": "markup.deleted",
			"settings": {
				"foreground": "#de042d"
			}
		},
		{
			"scope": [
				"markup.changed",
				"meta.diff.header"
			],
			"settings": {
				"foreground": "#b47104"
			}
		},
		{
			"name": "Go — import paths",
			"scope": "entity.name.import.go",
			"settings": {
				"foreground": "#8f8f8f"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"class": "#2c8052",
		"struct": "#2c8052",
		"type": "#2c8052",
		"interface": "#807503",
		"typeParameter": "#2c8052",
		"enum": "#cc2484",
		"enumMember": "#2c8052",
		"function": "#2c8052",
		"method": "#2c8052",
		"macro": "#217484",
		"namespace": "#7c6f64",
		"parameter": "#654735",
		"variable": "#654735",
		"property": "#654735",
		"jsonPropertyName": "#654735",
		"variable.readonly": "#cc2484",
		"constant": "#cc2484",
		"number": "#a54e88",
		"selfKeyword": "#a54e88",
		"decorator": "#217484",
		"label": "#217484",
		"controlKeyword": {
			"foreground": "#217484",
			"fontStyle": "italic"
		}
	}
}
